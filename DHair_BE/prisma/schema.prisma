generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model CHINHANH {
  MACHINHANH  String     @id @db.Char(20)
  TENCHINHANH String?    @db.VarChar(100)
  DIACHI      String?    @db.VarChar(200)
  SDT         String     @unique @db.Char(10)

  LICHHEN  LICHHEN[]
  NHANVIEN NHANVIEN[]
}

model CHITIETHOADON {
  MAHD      String @db.Char(20)
  MADV      String @db.Char(20)
  SOLUONG   Int?   @default(1)
  DONGIA    Int
  THANHTIEN Int

  DICHVU DICHVU @relation(fields: [MADV], references: [MADV], onUpdate: NoAction)
  HOADON HOADON @relation(fields: [MAHD], references: [MAHD], onUpdate: NoAction)

  @@id([MAHD, MADV])
}

model CHITIETLICHHEN {
  MALICH     String    @db.Char(20)
  MADV       String    @db.Char(20)
  SOLUONG    Int?      @default(1)
  GHICHU     String?   @db.VarChar(200)
  MANV       String?   @db.Char(20)
  GIA_DUKIEN Int?
  THOILUONG Int?
  PHATSINH  Boolean @default(false)

  LICHHEN  LICHHEN   @relation(fields: [MALICH], references: [MALICH], onUpdate: NoAction)
  DICHVU   DICHVU    @relation(fields: [MADV], references: [MADV], onUpdate: NoAction)
  NHANVIEN NHANVIEN? @relation(fields: [MANV], references: [MANV], onDelete: NoAction, onUpdate: NoAction)

  @@id([MALICH, MADV])
}

model DICHVU {
  MADV      String  @id @db.Char(20)
  LOAI      String  @db.Char(10)
  TENDV     String  @db.VarChar(100)
  MOTA      String? @db.VarChar(255)
  THOIGIAN  Int
  GIADV     Float
  TRANGTHAI String? @db.VarChar(50)
  HINH      String? @db.VarChar(255)
  QUYTRINH  String? @db.VarChar(255)

  CHITIETHOADON  CHITIETHOADON[]
  CHITIETLICHHEN CHITIETLICHHEN[]
}

model HOADON {
  MAHD              String    @id @db.Char(20)
  MAKM              String?   @db.Char(20)
  TONGTIEN          Int
  HINHTHUCTHANHTOAN String?   @db.VarChar(50)
  MANV              String?   @db.Char(20)
  MALICH            String?   @db.Char(20)
  TRANGTHAI         String?   @db.VarChar(50)
  MAKH              String?   @db.Char(20)
  NGAYTHANHTOAN     DateTime? @db.DateTime(0)

  CHITIETHOADON CHITIETHOADON[]

  KHUYENMAI KHUYENMAI? @relation(fields: [MAKM], references: [MAKM], onDelete: NoAction, onUpdate: NoAction)
  LICHHEN    LICHHEN?    @relation(fields: [MALICH], references: [MALICH], onDelete: NoAction, onUpdate: NoAction)
  NHANVIEN   NHANVIEN?   @relation(fields: [MANV], references: [MANV], onDelete: NoAction, onUpdate: NoAction)
  KHACHHANG  KHACHHANG?  @relation(fields: [MAKH], references: [MAKH], onDelete: NoAction, onUpdate: NoAction)
}

model KHACHHANG {
  MAKH   String  @id @db.Char(20)
  HOTEN  String  @db.VarChar(100)
  SDT    String  @unique @db.Char(10)
  MATK   String? @unique @db.Char(20)
  EMAIL  String? @db.VarChar(100)

  HOADON   HOADON[]
  LICHHEN  LICHHEN[]

  TAIKHOAN TAIKHOAN? @relation(fields: [MATK], references: [MATK], onDelete: NoAction, onUpdate: NoAction)
}

model KHUYENMAI {
  MAKM      String    @id @db.Char(20)
  TENKM     String    @db.VarChar(100)
  MOTA      String?   @db.VarChar(255)
  NGAYBD    DateTime? @db.DateTime(0)
  NGAYKT    DateTime? @db.DateTime(0)
  GIATRI    Float?
  TRANGTHAI String?   @db.VarChar(50)

  HOADON HOADON[]
}

model LICHHEN {
  MALICH     String    @id @db.Char(20)
  NGAYHEN    DateTime  @db.Date
  GIOHEN     DateTime  @db.Time(0)
  TRANGTHAI  String?   @db.VarChar(50)
  MACHINHANH String?   @db.Char(20)
  MAKH       String?   @db.Char(20)
  LOAILICH   String    @default("DAT_TRUOC") @db.VarChar(20)
  THOIGIANDEN DateTime? @db.DateTime(3)
  BATDAUTHUCTE DateTime? @db.DateTime(3)
  KETTHUCDUKIEN DateTime? @db.DateTime(3)
  KETTHUCTHUCTE DateTime? @db.DateTime(3)
  LYDOHUY String? @db.VarChar(200)
  HANGDOI HANGDOI?
  LICHSU LICHSULICH[]
  DANHGIA DANHGIALICH?

  CHITIETLICHHEN CHITIETLICHHEN[]
  HOADON         HOADON[]

  CHINHANH  CHINHANH?  @relation(fields: [MACHINHANH], references: [MACHINHANH], onDelete: NoAction, onUpdate: NoAction)
  KHACHHANG KHACHHANG? @relation(fields: [MAKH], references: [MAKH], onDelete: NoAction, onUpdate: NoAction)
}

model DANHGIALICH {
  MALICH String @id @db.Char(20)
  SOSAO Int
  NHANXET String @db.VarChar(500)
  TAOLUC DateTime @default(now()) @db.DateTime(3)
  LICHHEN LICHHEN @relation(fields: [MALICH], references: [MALICH], onDelete: Restrict, onUpdate: Cascade)

  @@index([TAOLUC])
}

model NHANVIEN {
  MANV       String    @id @db.Char(20)
  HOTEN      String    @db.VarChar(100)
  CHUCVU     String?   @db.VarChar(50)
  SDT        String?   @unique @db.Char(10)
  DIACHI     String?   @db.VarChar(200)
  MACHINHANH String?   @db.Char(20)
  NGAYSINH   DateTime? @db.DateTime(0)
  MATK       String?   @unique @db.Char(20)

  CHITIETLICHHEN CHITIETLICHHEN[]
  HOADON         HOADON[]
  LICHNGHI       LICHNGHI[]

  CHINHANH CHINHANH? @relation(fields: [MACHINHANH], references: [MACHINHANH], onDelete: NoAction, onUpdate: NoAction)
  TAIKHOAN TAIKHOAN? @relation(fields: [MATK], references: [MATK], onDelete: NoAction, onUpdate: NoAction)
}

model HANGDOI {
  MALICH String @id @db.Char(20)
  VAOLUC DateTime @default(now()) @db.DateTime(3)
  GOILUC DateTime? @db.DateTime(3)
  TRANGTHAI String @default("CHO") @db.VarChar(20)
  LICHHEN LICHHEN @relation(fields: [MALICH], references: [MALICH], onDelete: Cascade)
}

model LICHNGHI {
  ID String @id @db.Char(20)
  MANV String @db.Char(20)
  BATDAU DateTime @db.DateTime(3)
  KETTHUC DateTime @db.DateTime(3)
  LYDO String @db.VarChar(200)
  NHANVIEN NHANVIEN @relation(fields: [MANV], references: [MANV])
  @@index([MANV, BATDAU])
}

model LICHSULICH {
  ID String @id @db.Char(20)
  MALICH String @db.Char(20)
  NGUOISUA String @db.Char(20)
  THOIDIEM DateTime @default(now()) @db.DateTime(3)
  NOIDUNG String @db.Text
  LICHHEN LICHHEN @relation(fields: [MALICH], references: [MALICH], onDelete: Cascade)
  @@index([MALICH, THOIDIEM])
}

model TAIKHOAN {
  MATK      String @id @db.Char(20)
  PASS      String @db.VarChar(255)
  PHANQUYEN Int
  TRANGTHAI String @db.VarChar(50)

  KHACHHANG KHACHHANG?
  NHANVIEN  NHANVIEN?
}
