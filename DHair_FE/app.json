{
  "expo": {
    "name": "DHair_FE",
    "slug": "DHair_FE",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/img/logoDHair-mark.png",
    "scheme": "dhair_fe",
    "userInterfaceStyle": "automatic",
    "ios": {},
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a3673",
        "foregroundImage": "./assets/img/logoDHair-mark.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "bundler": "metro",
      "favicon": "./assets/img/logoDHair-mark.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1a3673",
          "image": "./assets/img/logoDHair.png",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
